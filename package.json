{
  "name": "@suisya-systems/rondo",
  "version": "0.0.0",
  "private": true,
  "description": "The host application: the one resident process a human talks to. Owns the source of truth, the web UI and a localhost MCP surface, and consumes continuo and cadenza as libraries.",
  "license": "MIT",
  "author": "suisya-systems <iwama.ryo.0731@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suisya-systems/rondo.git"
  },
  "bugs": {
    "url": "https://github.com/suisya-systems/rondo/issues"
  },
  "homepage": "https://github.com/suisya-systems/rondo#readme",
  "type": "module",
  "bin": {
    "rondo": "./bin/rondo.mjs"
  },
  "engines": {
    "node": ">=22.14.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run build && npm run lint && npm run knip && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "26.3.0",
    "knip": "6.32.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@suisya-systems/cadenza": "file:vendor/suisya-systems-cadenza-0.0.0.tgz"
  }
}
