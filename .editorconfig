# EditorConfig (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{ts,mts,js,mjs,json,jsonc}]
# Matches biome.json: two-space indent, line width 100.
indent_style = space
indent_size = 2
